generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { OWNER ADMIN MEMBER VIEWER }
enum PlanCode { FREE PRO BUSINESS ENTERPRISE }
enum LinkStatus { ACTIVE PAUSED ARCHIVED }

model User {
 id String @id @default(cuid())
 email String @unique
 name String?
 passwordHash String?
 emailVerifiedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 memberships Membership[]
 sessions Session[]
 links Link[]
 apiKeys ApiKey[]
 domains Domain[]
 ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
 auditLogs AuditLog[]
}
model Workspace {
 id String @id @default(cuid())
 name String
 slug String @unique
 ownerId String
 owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 memberships Membership[]
 links Link[]
 campaigns Campaign[]
 domains Domain[]
 apiKeys ApiKey[]
 subscription Subscription?
 auditLogs AuditLog[]
 @@index([ownerId])
}
model Membership {
 id String @id @default(cuid())
 userId String
 workspaceId String
 role Role @default(MEMBER)
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
 @@unique([userId, workspaceId])
 @@index([workspaceId, role])
}
model Session {
 id String @id @default(cuid())
 tokenHash String @unique
 userId String
 expiresAt DateTime
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId, expiresAt])
}
model Link {
 id String @id @default(cuid())
 slug String @unique
 targetUrl String
 title String?
 description String?
 ogImageUrl String?
 androidUrl String?
 iosUrl String?
 fallbackUrl String?
 passwordHash String?
 status LinkStatus @default(ACTIVE)
 active Boolean @default(true)
 expiresAt DateTime?
 clicks Int @default(0)
 ownerId String?
 workspaceId String?
 owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
 workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events ClickEvent[]
 rules SmartRule[]
 versions LinkVersion[]
 tags LinkTag[]
 campaignLinks CampaignLink[]
 @@index([ownerId, createdAt])
 @@index([workspaceId, createdAt])
 @@index([status, expiresAt])
}
model LinkVersion {
 id String @id @default(cuid())
 linkId String
 targetUrl String
 snapshot Json
 createdAt DateTime @default(now())
 link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
 @@index([linkId, createdAt])
}
model Tag { id String @id @default(cuid()); name String @unique; links LinkTag[] }
model LinkTag { linkId String; tagId String; link Link @relation(fields: [linkId], references: [id], onDelete: Cascade); tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade); @@id([linkId, tagId]) }
model SmartRule {
 id String @id @default(cuid())
 linkId String
 type String
 match String
 targetUrl String
 priority Int @default(0)
 active Boolean @default(true)
 link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
 @@index([linkId, priority])
}
model ClickEvent {
 id String @id @default(cuid())
 linkId String
 userAgent String?
 referer String?
 country String?
 device String?
 os String?
 browser String?
 ipHash String?
 isBot Boolean @default(false)
 utmSource String?
 utmMedium String?
 utmCampaign String?
 createdAt DateTime @default(now())
 link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
 @@index([linkId, createdAt])
 @@index([device, createdAt])
 @@index([country, createdAt])
}
model Campaign { id String @id @default(cuid()); workspaceId String; name String; source String?; medium String?; campaign String?; createdAt DateTime @default(now()); workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade); links CampaignLink[]; @@index([workspaceId, createdAt]) }
model CampaignLink { campaignId String; linkId String; campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade); link Link @relation(fields: [linkId], references: [id], onDelete: Cascade); @@id([campaignId, linkId]) }
model ApiKey { id String @id @default(cuid()); userId String?; workspaceId String?; name String; prefix String; keyHash String @unique; permissions String[]; createdAt DateTime @default(now()); lastUsedAt DateTime?; user User? @relation(fields: [userId], references: [id], onDelete: Cascade); workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade); @@index([userId, createdAt]); @@index([workspaceId, createdAt]) }
model Domain { id String @id @default(cuid()); userId String?; workspaceId String?; hostname String @unique; verified Boolean @default(false); verificationToken String @unique; createdAt DateTime @default(now()); user User? @relation(fields: [userId], references: [id], onDelete: Cascade); workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade); @@index([workspaceId, verified]) }
model Subscription { id String @id @default(cuid()); workspaceId String @unique; plan PlanCode @default(FREE); status String @default("active"); providerCustomerId String?; providerSubscriptionId String?; currentPeriodEnd DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) }
model AuditLog { id String @id @default(cuid()); workspaceId String; userId String?; action String; entity String; entityId String?; metadata Json?; createdAt DateTime @default(now()); workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade); user User? @relation(fields: [userId], references: [id], onDelete: SetNull); @@index([workspaceId, createdAt]) }
